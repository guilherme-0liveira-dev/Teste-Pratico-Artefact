# ========================================================
# Empório AI — Environment Configuration
# ========================================================

# LLM Provider Configuration (NVIDIA NIM / OpenAI-Compatible)
# Get a free API key at https://build.nvidia.com
LLM_PROVIDER=nvidia
LLM_API_KEY=your_nvidia_api_key_here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Database & Ingestion Paths
DATABASE_URL=sqlite:///./emporio.db
DATA_DIR=./data
DOCS_DIR=./docs
POLICY_PDF_PATH=./docs/políticas_da_loja.pdf

# Agent Configuration
AGENT_MAX_ITERATIONS=5
LOG_LEVEL=INFO
